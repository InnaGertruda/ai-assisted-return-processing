# Browser-visible, non-secret API location. Configure locally only when the UI needs it.
VITE_API_BASE_URL=

# Required backend session lifetime in minutes (valid range: 1-1440).
# For local development, store the value in Visual Studio/.NET User Secrets.
RETURNFLOW_SESSION_LIFETIME_MINUTES=

# Optional backend-only Live model configuration. Live is disabled by default.
# Keep LIVE_MODEL_API_KEY in .NET User Secrets, the process environment, or Fly.io Secrets.
LIVE_MODEL_ENABLED=false
LIVE_MODEL_API_KEY=
LIVE_MODEL_ID=
LIVE_MODEL_TIMEOUT_SECONDS=10
LIVE_MODEL_MAX_OUTPUT_TOKENS=1024
LIVE_MODEL_SESSION_REQUESTS_PER_MINUTE=2
LIVE_MODEL_SESSION_REQUESTS_PER_DAY=10
LIVE_MODEL_CLIENT_REQUESTS_PER_MINUTE=4
LIVE_MODEL_GLOBAL_REQUESTS_PER_DAY=50
